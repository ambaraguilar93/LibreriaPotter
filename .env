# Activa el backend simulado (MSW). La app no tiene backend real, por eso viene activado.
# Con "true" el mock funciona en npm run dev y también en el build (npm run build + npm run preview).
VITE_USAR_MOCK=true

# Ruta base donde se publica la app. "/" para local; "/LibreriaPotter/" para GitHub Pages.
VITE_BASE=/